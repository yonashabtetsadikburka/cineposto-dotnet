# Copy this file to .env and fill it in. .env is ignored by git; never commit real values.

# Host port where the api is published.
API_PORT=8080

# Required, no default. At least 16 characters. The api refuses to start without it.
# Generate one with:
#   openssl rand -hex 32
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
ADMIN_TOKEN=

# SQLite file inside the containers. It lives in the named volume "data", shared by api and scraper.
CINEPOSTO_DB_PATH=/data/cineposto.db

# fixtures: read saved responses, no network (default for local runs).
# live:     call the real cinema websites.
SCRAPER_MODE=fixtures

# fixtures mode only: host folder with the saved responses (mounted read-only) and the case to read.
FIXTURES_DIR=./tests/CinePosto.Connectors.Tests/Golden
SCRAPER_FIXTURES_CASE=settings_valid

# live mode only. Leave the user agent empty to use the default (CinePosto/0.1), or set one that identifies you.
SCRAPER_USER_AGENT=
SCRAPER_HTTP_TIMEOUT_SECONDS=30

# Reserved for the TMDb backdrop lookup, which is not ported yet. Leave empty.
TMDB_READ_TOKEN=
