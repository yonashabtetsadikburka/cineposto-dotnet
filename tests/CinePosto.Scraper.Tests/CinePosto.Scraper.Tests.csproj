<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CinePosto.Scraper\CinePosto.Scraper.csproj" />
  </ItemGroup>

  <!-- The golden cases of the connector tests are the fixtures of the scraper: linked, not copied. -->
  <ItemGroup>
    <None Include="..\CinePosto.Connectors.Tests\Golden\clarici\settings_valid\*" Link="Fixtures\settings_valid\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CinePosto.Connectors.Tests\Golden\clarici\movies_http500\*" Link="Fixtures\movies_http500\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CinePosto.Connectors.Tests\Golden\clarici\movies_body_not_json\*" Link="Fixtures\movies_body_not_json\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CinePosto.Connectors.Tests\Golden\uci\eight_day_window\*" Link="Fixtures\uci\eight_day_window\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CinePosto.Connectors.Tests\Golden\uci\eight_day_window_http500\*" Link="Fixtures\uci\eight_day_window_http500\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CinePosto.Connectors.Tests\Golden\thespace\eight_day_window\**\*" Link="Fixtures\thespace\eight_day_window\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CinePosto.Connectors.Tests\Golden\thespace\eight_day_window_blocked\**\*" Link="Fixtures\thespace\eight_day_window_blocked\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
